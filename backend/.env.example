# Server
PORT=8080
ALLOWED_ORIGIN=http://localhost:5173

# Local Postgres (see docker-compose.yml at repo root). Swap for the
# Supabase Postgres connection string in production.
DATABASE_URL=postgres://finedu:finedu@localhost:5432/finedu?sslmode=disable

# Supabase Auth (project URL; JWTs issued to the frontend are verified
# against the public JWKS at <SUPABASE_URL>/auth/v1/.well-known/jwks.json)
SUPABASE_URL=

# Supabase anon (public) key — the same key shipped in the frontend bundle
# (VITE_SUPABASE_ANON_KEY). Needed here so the backend can call Supabase's
# signup endpoint on the user's behalf after validating the request. This is
# NOT the service role key and must never be replaced with one.
SUPABASE_ANON_KEY=

# AI provider
OPENAI_API_KEY=

# Market data provider (Alpha Vantage, Finnhub, or Twelve Data)
MARKET_DATA_API_KEY=
